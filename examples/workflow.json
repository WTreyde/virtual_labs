  "steps": [
    {
      "id": "load",
      "name": "Pick empty plate",
      "capability": "plate_storage",
      "candidate_instances": [
        "hotel_1"
      ],
      "duration_s": 0,
      "after": []
    },
    {
      "id": "dispense",
      "name": "Dispense enzyme and substrate",
      "capability": "liquid_handling",
      "candidate_instances": [
        "lh_1"
      ],
      "duration_s": 1800,
      "after": [
        "load"
      ],
      "params": {
        "volume_ul": 100
      }
    },
    {
      "id": "seal",

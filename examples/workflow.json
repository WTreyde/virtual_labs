      "rationale": "44 slots covers 1 h incubation at 40 plates/day."
    },
    {
      "instance_id": "reader_1",
      "catalog_id": "bmg_clariostar",
      "rationale": "Absorbance readout; also covers fluorescence for later assays."
    },
    {
      "instance_id": "arm_1",
      "catalog_id": "ur5e",
      "rationale": "Central arm moves plates between all stations."
    }
